# Sao chép file này thành .env.local để bật kết nối thật.
# Chưa có .env.local => app chạy ở chế độ dữ liệu mẫu (mock), vẫn xem được đầy đủ giao diện.
#
# Giá trị dưới đây là của App Tổng HPCons đang chạy thật tại https://hpcore.vn
# (portal đăng nhập: https://account.hpcore.vn) — Firebase project "hpcons-portal".
# Cấu hình web Firebase KHÔNG phải bí mật (mọi web app Firebase đều lộ ở client);
# bảo mật thật sự nằm ở Firestore Security Rules. Xem lib/firebase/config.ts.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDtF6mzeCk9snm7I6-IayZ1OYc0AxiGAUE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hpcons-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hpcons-portal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hpcons-portal.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=459933685455
NEXT_PUBLIC_FIREBASE_APP_ID=1:459933685455:web:da27ee2c5c493459dfc9ba

# Liên kết quay về App Tổng (hiện trên Sidebar)
NEXT_PUBLIC_APP_TONG_URL=https://hpcore.vn

# ===== SSO ĐĂNG NHẬP QUA APP TỔNG (20/08/2026) =====
# Bật đăng nhập thật qua account.hpcore.vn thay cho tài khoản riêng của app này.
NEXT_PUBLIC_XAC_THUC=sso

# Khóa Admin SDK (JSON một dòng) của project `hpcons-portal` — DÙNG CHUNG với mọi app con
# khác trong hệ sinh thái HPcore (Đấu Thầu, Booking, Cuộc Họp...), xin lại từ đội triển khai
# một app con bất kỳ đã có sẵn, ĐỪNG tự tạo khóa mới. 🔴 ĐÂY LÀ BÍ MẬT THẬT — khác hẳn 6 biến
# NEXT_PUBLIC_FIREBASE_* phía trên (những cái đó lộ ra client vô hại). Biến này KHÔNG có tiền
# tố NEXT_PUBLIC_ nên chỉ chạy được phía máy chủ (route `app/api/auth/hpcore-session`), tuyệt
# đối không thêm tiền tố NEXT_PUBLIC_ vào tên biến này.
#
# 📌 Từ 20/08/2026 đây CŨNG là khóa dùng cho route "cửa tiếp nhận" từ App Request
# (app/api/app-request/de-nghi-moi, xem 5-ket-noi/hpcore-may-chu.ts) — KHÔNG cần khóa riêng
# nào khác, cùng project `hpcons-portal` với phần đăng nhập SSO ở trên.
HPCORE_FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"hpcons-portal",...}

# Khóa App Request dùng để gọi vào route de-nghi-moi (header x-api-key). Để trống thì route
# vẫn chạy (không kiểm khóa) — dùng để 2 đội test trước khi thống nhất khóa thật.
APP_REQUEST_API_KEY=
