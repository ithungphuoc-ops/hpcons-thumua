# Sao chép file này thành .env.local để bật kết nối thật.
# Chưa có .env.local => app chạy ở chế độ dữ liệu mẫu (mock), vẫn xem được đầy đủ giao diện.
#
# Giá trị dưới đây là của App Tổng HPCons đang chạy thật tại https://hpcore.vn
# (portal đăng nhập: https://account.hpcore.vn) — Firebase project "hpcons-portal".
# Cấu hình web Firebase KHÔNG phải bí mật (mọi web app Firebase đều lộ ở client);
# bảo mật thật sự nằm ở Firestore Security Rules. Xem lib/firebase/config.ts.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDtF6mzeCk9snm7I6-IayZ1OYc0AxiGAUE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hpcons-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hpcons-portal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hpcons-portal.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=459933685455
NEXT_PUBLIC_FIREBASE_APP_ID=1:459933685455:web:da27ee2c5c493459dfc9ba

# Liên kết quay về App Tổng (hiện trên Sidebar)
NEXT_PUBLIC_APP_TONG_URL=https://hpcore.vn

# ===== SSO ĐĂNG NHẬP QUA APP TỔNG (20/08/2026) =====
# Bật đăng nhập thật qua account.hpcore.vn thay cho tài khoản riêng của app này.
NEXT_PUBLIC_XAC_THUC=sso

# Khóa Admin SDK (JSON một dòng) của project `hpcons-portal` — DÙNG CHUNG với mọi app con
# khác trong hệ sinh thái HPcore (Đấu Thầu, Booking, Cuộc Họp...), xin lại từ đội triển khai
# một app con bất kỳ đã có sẵn, ĐỪNG tự tạo khóa mới. 🔴 ĐÂY LÀ BÍ MẬT THẬT — khác hẳn 6 biến
# NEXT_PUBLIC_FIREBASE_* phía trên (những cái đó lộ ra client vô hại). Biến này KHÔNG có tiền
# tố NEXT_PUBLIC_ nên chỉ chạy được phía máy chủ (route `app/api/auth/hpcore-session`), tuyệt
# đối không thêm tiền tố NEXT_PUBLIC_ vào tên biến này.
#
# 📌 Từ 20/08/2026 đây CŨNG là khóa dùng cho route "cửa tiếp nhận" từ App Request
# (app/api/app-request/de-nghi-moi, xem 5-ket-noi/hpcore-may-chu.ts) — KHÔNG cần khóa riêng
# nào khác, cùng project `hpcons-portal` với phần đăng nhập SSO ở trên.
HPCORE_FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"hpcons-portal",...}

# Khóa App Request dùng để gọi vào route de-nghi-moi (header x-api-key). Để trống thì route
# vẫn chạy (không kiểm khóa) — dùng để 2 đội test trước khi thống nhất khóa thật.
APP_REQUEST_API_KEY=

# ===== ĐỌC LOẠI ĐỀ NGHỊ TỪ APP REQUEST (15/09/2026) =====
# Khóa Admin SDK (JSON một dòng) của project Firebase **`hpcons-request`** — KHÁC project
# `hpcons-portal` ở trên, nên KHÔNG dùng lại HPCORE_FIREBASE_SERVICE_ACCOUNT được. Xin từ đội
# App Request. 🔴 ĐÂY LÀ BÍ MẬT THẬT: không tiền tố NEXT_PUBLIC_, không nhúng nội dung tệp khóa
# vào mã nguồn hay vào chính file ví dụ này (dòng dưới để TRỐNG là cố ý).
#
# Dùng ở: app/api/app-request/de-nghi-moi/route.ts -> docLoaiTuHoSoAppRequest(). Cửa tiếp nhận
# đọc `requests/{requestId}` bên App Request để biết đề nghị là của CÔNG TRÌNH hay PHÒNG BAN
# (ô "Lựa chọn đề nghị"), vì App Request chưa gửi trường đó trong payload.
#
# ⚠️ ĐỂ TRỐNG KHÔNG LÀM HỎNG GÌ: route vẫn nhận đề nghị bình thường, chỉ bỏ qua bước đọc sang
# và rơi về phép suy dự phòng `maHopDongCDT` rỗng (đã đo 15/09/2026: khớp 16/16, lệch 0).
APP_REQUEST_FIREBASE_SERVICE_ACCOUNT=

# ===== VIỆC 2 (20/08/2026): GỬI PO SANG QLK CTR =====
# Địa chỉ QLK CTR đang chạy thật + khóa gọi vào route /api/app-mua-hang/po-moi của họ. Route
# /api/qlk-ctr/gui-po (phía Thu mua) dùng 2 biến này — xem 5-ket-noi/gui-po-qlk-ctr.ts. Để
# trống QLKCTR_API_URL thì tự tắt (không gửi gì, không lỗi khi lập PO).
QLKCTR_API_URL=
QLKCTR_API_KEY=

# ===== THÔNG BÁO SANG CHUÔNG APP TỔNG (Sếp duyệt demo 08/10/2026) =====
# Khoá gọi cổng App Tổng POST /api/notifications/ingest (header Authorization: Bearer …). Phải TRÙNG khoá
# App Tổng cấu hình cho appId 'thu_mua'. ĐỂ TRỐNG = TẮT HẲN (không đọc Firestore, không gọi mạng, việc
# nghiệp vụ không đổi gì). Xem 5-ket-noi/thong-bao-app-tong-may-chu.ts.
NOTIFY_INGEST_KEY=
# Tuỳ chọn — đổi địa chỉ cổng (mặc định https://account.hpcore.vn/api/notifications/ingest).
NOTIFY_INGEST_URL=

# ===== LIÊN KẾT MUA HÀNG EQUI (Sếp duyệt 15/10/2026) — CHỈ ẢNH HƯỞNG KHO EQUI =====
# App EQUI (https://equi.hpcore.vn) đóng vai "App Kho" cho đề xuất nhóm "(EQUI)". Kho thường vẫn đi QLK CTR
# như cũ (QLKCTR_API_URL / QLKCTR_API_KEY ở trên) — nhóm "(EQUI)" KHÔNG BAO GIỜ gửi sang QLK CTR.
#
# Gửi PO của kho EQUI → App EQUI. Route /api/equi/gui-po và /api/equi/gui-po-doc-lap (phía Thu mua, giữ khoá)
# gọi {EQUI_API_URL}/api/app-mua-hang/po-moi | po-doc-lap, header x-api-key = EQUI_API_KEY (phải TRÙNG
# APP_MUA_HANG_API_KEY bên App EQUI). Để trống EQUI_API_URL → route trả 500 "tạm thời", PO kho EQUI nằm ở
# hàng tự thử lại theo bậc chờ; khai xong là tự gửi. Xem 5-ket-noi/gui-po-equi.ts.
EQUI_API_URL=
EQUI_API_KEY=
# Nhận phiếu nhận hàng từ App EQUI → POST /api/equi/phieu-nhan-moi (ghi vào KHO EQUI), App EQUI gửi kèm
# x-api-key (bên đó là THUMUA_API_KEY, phải TRÙNG khoá này). 🔴 ĐỂ TRỐNG = ĐÓNG CỔNG (503), khác cửa QLK CTR.
EQUI_PHIEU_NHAN_API_KEY=
