rules_version = '2';

// ============================================================================
// SECURITY RULES — BẢN CHẠY THỬ, project `hpcons-thumua`
//
// ✅ TỪ 12/08/2026 ĐÃ SIẾT: phải đăng nhập bằng tài khoản thật mới đọc/ghi được.
//    Mỗi người một tài khoản riêng, mật khẩu do máy chủ Google giữ.
//
// 🔴 CÓ MỘT CÔNG TẮC Ở NGAY DƯỚI (`batBuocDangNhap`). Đọc kỹ trước khi đổi.
//
// Vì sao phải có công tắc chứ không siết luôn: siết rules TRƯỚC khi mọi người có tài
// khoản là **khóa cả phòng ra ngoài** — app mở lên trắng trơn, không ai hiểu vì sao, và
// người đang nhập dở mất việc. Thứ tự bắt buộc:
//
//   ① Bật Authentication → Email/Password trong Firebase Console
//   ② Chạy `node tao-tai-khoan.js` tạo tài khoản + hồ sơ cho TỪNG người
//   ③ Giao mật khẩu, xác nhận mọi người đăng nhập được
//   ④ Đặt `NEXT_PUBLIC_XAC_THUC=firebase` rồi deploy
//   ⑤ MỚI đổi `batBuocDangNhap()` thành `true` và deploy rules
//
// Làm sai thứ tự thì hoặc là khóa người dùng ngoài app (④⑤ trước ②), hoặc là tưởng đã
// bảo mật mà thật ra vẫn mở toang (④ mà quên ⑤).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * 🔴 CÔNG TẮC BẢO MẬT.
     *
     * `false` = ai cũng đọc/sửa được dữ liệu chạy thử, KHÔNG CẦN ĐĂNG NHẬP.
     *           Ai mở https://hpcons-thumua-github.vercel.app bấm F12 là thấy mã project
     *           trong mã nguồn trang, từ đó đọc và sửa toàn bộ dữ liệu.
     *           👉 CHỈ ĐƯỢC NHẬP DỮ LIỆU GIẢ ĐỊNH. Không giá thật, không tên người thật,
     *              không số hợp đồng thật.
     *
     * `true`  = phải đăng nhập bằng tài khoản thật mới đọc/ghi được. Đây mới là lúc
     *           việc "phân quyền riêng cho từng người" có ý nghĩa ở tầng dữ liệu.
     *
     * ⚠️ Đổi giá trị này rồi PHẢI deploy lại rules mới có hiệu lực. Sửa file không thôi
     * thì không có gì thay đổi trên máy chủ.
     */
    // ✅ ĐÃ BẬT 12/08/2026, sau khi đủ 4 điều kiện ①②③④ ở trên. Từ lúc này người chưa
    // đăng nhập KHÔNG đọc được một dòng dữ liệu nào — kể cả khi mở thẳng Firestore.
    function batBuocDangNhap() {
      return true;
    }

    function duocVao() {
      return batBuocDangNhap() ? request.auth != null : true;
    }

    /** Hết hạn 01/11/2026. Đổi ngày này là hành động có ý thức, không phải mặc định. */
    function conHanChayThu() {
      return request.time < timestamp.date(2026, 11, 1);
    }

    // ------------------------------------------------------------------
    // KHO DỮ LIỆU CHUNG của bản chạy thử — MỘT document duy nhất.
    // ------------------------------------------------------------------
    match /chay-thu/{tep} {
      allow read, write: if conHanChayThu() && duocVao();
    }

    /**
     * Hồ sơ của CHÍNH người đang gọi rule (nếu có) — dùng để soi quyền
     * `phanQuyenNguoiDung` (xem `4-phan-quyen/quyen.ts`: `laQuanTri || capTM >= 3`) ngay ở
     * tầng dữ liệu, không chỉ ở màn hình. `exists()` đứng trước để `get()` phía sau không
     * bao giờ chạy khi hồ sơ chưa có (rules đánh giá `&&` theo kiểu ngắn mạch).
     */
    function tmHoSoNguoiGoi() {
      return get(/databases/$(database)/documents/nguoi-dung/$(request.auth.uid)).data;
    }

    /**
     * ⚠️ Chưa xử lý ở đây: tài khoản OWNER App Tổng (xem `ho-so-tai-khoan.ts`, khối "OWNER
     * TOÀN QUYỀN") KHÔNG có tài liệu `nguoi-dung/{uid}` — `docHoSoTaiKhoan()` trả hồ sơ dựng
     * sẵn, không đụng Firestore. Bản deploy thật (`hpcons-portal/firestore.rules`) cộng thêm
     * nhánh kiểm `users/{uid}.role == 'owner'` (collection có sẵn ở project đó vì SSO dùng
     * chung project). File NÀY là bản nguồn cho một project ĐỘC LẬP giả định
     * (xem đầu file) nên không có collection `users` để kiểm — đừng copy y nguyên hàm này
     * sang App Tổng mà thiếu nhánh owner, kẻo khóa luôn owner khỏi trang Nhật ký hệ thống.
     */
    function tmDuocXemNhatKy() {
      return duocVao()
        && exists(/databases/$(database)/documents/nguoi-dung/$(request.auth.uid))
        && (tmHoSoNguoiGoi().vaiTro == 'admin' || tmHoSoNguoiGoi().capTM >= 3);
    }

    /**
     * `nguoiDung.uid` mà toàn app dùng (kể cả khi ghi nhật ký) thực ra là `uidNghiepVu` —
     * mã BỀN VỮNG trong dữ liệu nghiệp vụ (`u-tm1`…), KHÔNG PHẢI mã Firebase — xem
     * "hai lớp danh tính" ở `ho-so-tai-khoan.ts`. Tài khoản cũ giữ nguyên `uidNghiepVu` cũ
     * dù đổi vai trò, nên `uidNghiepVu` có thể KHÁC `request.auth.uid`. So khớp thẳng với
     * `request.auth.uid` (bản vá đầu 29/08/2026) làm rớt nhật ký của mọi tài khoản cũ.
     *
     * 🔴 KHÔNG có nhánh dự phòng `: request.auth.uid` cho người CHƯA có hồ sơ như bản vá lần
     * 2 từng làm — review lần 3 chỉ đúng: làm vậy là mở cửa cho BẤT KỲ tài khoản nào (không
     * riêng owner) ghi được một dòng nhật ký "hợp lệ" dù chưa từng được cấp quyền Thu mua.
     * File này không có collection `users` để tự kiểm ai thật sự là owner App Tổng (khác bản
     * deploy thật `hpcons-portal/firestore.rules`, có nhánh `tmLaOwnerAppTong()` riêng) — nên
     * ở ĐÂY, thiếu hồ sơ là bị `exists()` ở luật `create` chặn thẳng, không có ngoại lệ nào.
     */
    function tmUidNghiepVuCuaNguoiGoi() {
      return get(/databases/$(database)/documents/nguoi-dung/$(request.auth.uid)).data.uidNghiepVu;
    }

    // ------------------------------------------------------------------
    // NHẬT KÝ HỆ THỐNG — thêm 29/08/2026, xem chú thích đầy đủ ở
    // `3-du-lieu/nhat-ky-he-thong.ts`.
    //
    // 🔴 CHỈ CHO TẠO (`create`), TUYỆT ĐỐI KHÔNG CHO SỬA/XÓA. Nhật ký mà tự sửa/xóa được thì
    // mất hết ý nghĩa tồn tại — đúng người vừa xóa dữ liệu chạy thử lại tiện tay xóa luôn
    // dòng nhật ký tố cáo chính mình. KHÔNG áp `conHanChayThu()` như collection trên: nhật ký
    // vẫn phải ghi/đọc được ngay cả khi qua ngày hết hạn "chạy thử" — tách khỏi vòng đời dữ
    // liệu tạm để phục vụ đúng vai trò của nó.
    //
    // 🔴 ĐỌC: giới hạn đúng bằng quyền `phanQuyenNguoiDung` ở màn hình (cùng mức nhạy cảm
    // với "Phân quyền người dùng") — KHÔNG chỉ "đã đăng nhập là đủ" như bản đầu (29/08/2026),
    // vì "đã đăng nhập là đủ" nghĩa là bất kỳ tài khoản nào cũng gọi thẳng Firestore SDK từ
    // console trình duyệt để đọc toàn bộ nhật ký ai-xóa-gì-lúc-nào, bỏ qua hẳn màn chặn UI.
    //
    // 🔴 TẠO: bắt buộc `nguoiThucHienUid` khớp đúng `uidNghiepVu` trong hồ sơ CỦA CHÍNH người
    // đang ghi — không thì bất kỳ ai đã đăng nhập cũng `addDoc` thẳng một dòng nhật ký giả,
    // đổ tội hành động cho người khác, mà rule cấm sửa/xóa nên tạo giả xong thì không ai gỡ
    // được nữa. Chưa có hồ sơ (`exists()` phía dưới) thì bị chặn hẳn, không có ngoại lệ nào —
    // xem vì sao ở `tmUidNghiepVuCuaNguoiGoi()`.
    // ------------------------------------------------------------------
    match /nhat-ky-he-thong/{id} {
      allow read: if tmDuocXemNhatKy();
      allow create: if duocVao()
        && exists(/databases/$(database)/documents/nguoi-dung/$(request.auth.uid))
        && request.resource.data.nguoiThucHienUid == tmUidNghiepVuCuaNguoiGoi();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // HỒ SƠ PHÂN QUYỀN — mỗi người một tài liệu `nguoi-dung/{firebaseUid}`
    // ------------------------------------------------------------------
    //
    // 🔴 CHỈ ĐỌC, KHÔNG AI GHI ĐƯỢC TỪ TRÌNH DUYỆT. Đây là điều khoản quan trọng nhất
    // của cả file: hồ sơ chứa `capTM` — cấp quyền của chính người đó. Cho ghi là người
    // dùng tự sửa mình lên cấp 4, và toàn bộ phân quyền thành vô nghĩa.
    // Hồ sơ chỉ được tạo/sửa bằng khóa Admin SDK (script `tao-tai-khoan.js`), mà khóa đó
    // đi vòng qua Security Rules nên không bị chặn.
    //
    // ⚠️ Cho đọc CẢ collection chứ không chỉ hồ sơ của mình: bảng phân bổ cần danh sách
    // nhân viên thu mua để trưởng bộ phận giao việc. Hồ sơ không chứa gì bí mật hơn tên,
    // chức danh và cấp quyền — những thứ đằng nào cũng hiện trên giao diện.
    match /nguoi-dung/{uid} {
      allow read: if duocVao();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // NỘI DUNG TỆP ĐÍNH KÈM — `tep/{tepId}` + mảnh con `tep/{tepId}/manh/{i}`
    // ------------------------------------------------------------------
    //
    // 🔴 Ban lãnh đạo 12/08/2026 chọn lưu tệp vào Firestore để máy khác mở xem được.
    // Firestore chỉ cho 1MB mỗi tài liệu nên tệp bị cắt thành nhiều mảnh base64 — xem
    // `3-du-lieu/kho-tep-firestore.ts`.
    //
    // ⚠️ PHẢI CÓ `{manh=**}` (hoặc khai riêng collection con). Rules KHÔNG tự áp xuống
    // collection con: khai mỗi `tep/{tepId}` thì mảnh bị chặn, và người dùng thấy đúng cảnh
    // "tải lên xong mà mở ra không có gì".
    match /tep/{tepId} {
      allow read, write: if conHanChayThu() && duocVao();
      match /{duongDanCon=**} {
        allow read, write: if conHanChayThu() && duocVao();
      }
    }

    // ==================================================================
    // ★★★ KHỐI CẤU TRÚC TÁCH — THÊM 17/09/2026, KHI BẬT BƯỚC 2
    // ==================================================================
    //
    // 🔴 VÌ SAO KHỐI NÀY NẰM TRONG CHÍNH TỆP ĐANG CHẠY THẬT, KHÔNG PHẢI MỘT TỆP RIÊNG:
    //
    // Bản nháp `firestore-tach-chung-tu.rules` (16/09) chỉ có mấy khối `tm_*`. Đem publish
    // nguyên trạng là **cắt mất bốn khối mà app vẫn đang cần**: `chay-thu` (bản cũ còn chạy
    // trên máy mọi người cho tới khi họ tải lại trang), `nguoi-dung` (danh bạ), `tep` (toàn bộ
    // tệp đính kèm) và `nhat-ky-he-thong`. Triệu chứng sẽ là cả phòng mất đính kèm và mất danh
    // bạ ngay giây publish — nặng hơn nhiều so với việc đang định sửa.
    //
    // Chính tệp nháp đó đã tự cảnh báo đúng cái bẫy này ("siết rules TRƯỚC khi mọi người có
    // tài khoản", sự cố 12/08/2026) mà vẫn suýt rơi vào. Nên: GIỮ NGUYÊN mọi thứ đang chạy,
    // chỉ THÊM vào.
    //
    // ⚠️ `chay-thu/{tep}` Ở TRÊN CỐ Ý CHƯA XOÁ. Hai cấu trúc sống song song vài ngày là đúng:
    // deploy không đẩy mã mới sang tab đang mở, nên sau khi deploy vẫn còn máy chạy bản cũ đọc
    // đường cũ. Gỡ `chay-thu` chỉ khi đã chắc không còn ai ở bản cũ — và đó là một lượt sửa
    // riêng, có chủ ý, không phải dọn kèm.
    //
    // 📌 KHÔNG lồng dưới `projects/{pid}` như `firestore.rules` mô tả — Sếp chốt 16/09/2026.
    //    Lý do đo được: hồ sơ PHÒNG BAN không thuộc dự án nào, `maDuAn` của nó đang mang chính
    //    tên phòng ban. Lồng bây giờ là tạo ra những "dự án" tên phòng ban. Mỗi tài liệu vẫn
    //    giữ trường `maDuAn` nên sau này chuyển sang lồng chỉ là chép một lần.

    function daDangNhap() {
      return request.auth != null;
    }

    /**
     * 🔴 CÔNG TẮC TẦNG CLAIMS — ĐANG TẮT.
     *
     * Đổi thành `true` CHỈ KHI đủ cả ba điều, theo đúng thứ tự:
     *   ① App Tổng đã ghi claims `{ role, apps: { tm: … , kh: … } }` cho MỌI người dùng app;
     *   ② Đã kiểm trên một tài khoản thật rằng `request.auth.token.apps.tm` đọc ra đúng số;
     *   ③ Đã báo trước cho cả phòng — vì ai thiếu claims sẽ mất quyền ngay lúc deploy.
     *
     * ⚠️ Bật khi chưa đủ ba điều là khoá cả phòng ra ngoài. Đây không phải lo xa: app từng
     * phải lùi một lần vì siết rules trước khi mọi người có tài khoản (12/08/2026).
     */
    function daCoClaims() {
      return false;
    }

    function vaiTro() {
      return daDangNhap() ? request.auth.token.get('role', 'staff') : '';
    }

    function laQuanTri() {
      return vaiTro() == 'admin';
    }

    function laBanGiamDoc() {
      return vaiTro() == 'director';
    }

    /** Cấp quyền trong một app con. 0 = chưa được cấp. */
    function cap(app) {
      return daDangNhap() ? request.auth.token.get('apps', {}).get(app, 0) : 0;
    }

    /**
     * Ai được đọc hồ sơ mua hàng KHÔNG CÓ GIÁ (đề nghị · đơn hàng · phiếu nhận).
     * Kho (`kh`) CÓ trong danh sách — họ cần biết đặt hàng gì để nhận hàng.
     */
    function duocXemHoSoMuaHang() {
      return daCoClaims()
        ? (laQuanTri() || laBanGiamDoc()
           || cap('tm') >= 1 || cap('kh') >= 1 || cap('qd') >= 1 || cap('kt') >= 1)
        : daDangNhap();
    }

    /**
     * 🔒 Ai được đọc TIỀN (đơn giá, báo giá).
     * ⛔ KHÔNG có Kho (`kh`) — đây chính là điều khoản chặn giá, và là lý do `tm_donhang_gia`
     * phải là một document RIÊNG: Security Rules chặn được cả document, KHÔNG chặn được từng
     * trường. Sếp 16/09/2026: *"kho thì không cần biết giá"*.
     *
     * ⚠️ Khi `daCoClaims()` còn `false` thì hàm này rơi về "cứ đăng nhập là đọc được", tức
     * CHẶN GIÁ CHƯA CÓ HIỆU LỰC. Tách document là bước chuẩn bị, chưa phải bảo vệ.
     */
    function duocXemTien() {
      return daCoClaims()
        ? (laQuanTri() || laBanGiamDoc() || cap('tm') >= 1 || cap('qd') >= 1 || cap('kt') >= 1)
        : daDangNhap();
    }

    /** Nhập liệu trở lên trong app Thu mua. */
    function nhapLieuThuMua() {
      return daCoClaims() ? (laQuanTri() || cap('tm') >= 2) : daDangNhap();
    }

    /** Quản lý trở lên trong app Thu mua. */
    function quanLyThuMua() {
      return daCoClaims() ? (laQuanTri() || cap('tm') >= 3) : daDangNhap();
    }

    /** Thủ kho — người DUY NHẤT được ghi số thực nhận. */
    function thuKho() {
      return daCoClaims() ? (laQuanTri() || cap('kh') >= 2 || cap('tm') >= 3) : daDangNhap();
    }

    // ---------- ĐỀ NGHỊ MUA HÀNG — KHÔNG chứa giá ----------
    match /tm_denghi/{prId} {
      allow read: if conHanChayThu() && duocXemHoSoMuaHang();
      allow create, update: if conHanChayThu() && nhapLieuThuMua();
      allow delete: if conHanChayThu() && quanLyThuMua();
    }

    // ---------- ĐƠN ĐẶT HÀNG — KHÔNG chứa giá ----------
    match /tm_donhang/{poId} {
      allow read: if conHanChayThu() && duocXemHoSoMuaHang();
      allow create: if conHanChayThu() && nhapLieuThuMua();
      allow update: if conHanChayThu() && nhapLieuThuMua();
      allow delete: if conHanChayThu() && quanLyThuMua();

      // ---------- PHIẾU NHẬN HÀNG — lồng trong đơn (Sếp chốt 16/09/2026) ----------
      // 🔴 Kho là NGUỒN DUY NHẤT của số thực nhận: Thu mua và QLDA chỉ đọc, KHÔNG tự ghi
      // số nhận thay kho. Cấp 3 của app tm được ghi chỉ để sửa sai sót nghiệp vụ.
      //
      // ⚠️ RULE NÀY CHỈ ÁP CHO TRUY CẬP TRỰC TIẾP `tm_donhang/{poId}/nhanhang/{grnId}`.
      // 🔴 NÓ **KHÔNG** ÁP CHO `collectionGroup("nhanhang")` — xem khối riêng bên dưới.
      // Tôi đã kết luận sai chiều này ngày 17/09/2026 và làm app mất kết nối trên production.
      match /nhanhang/{grnId} {
        allow read: if conHanChayThu() && duocXemHoSoMuaHang();
        allow create, update: if conHanChayThu() && thuKho();
        allow delete: if conHanChayThu() && quanLyThuMua();
      }
    }

    // ---------- 🔴 PHIẾU NHẬN ĐỌC BẰNG collectionGroup — KHỐI BẮT BUỘC RIÊNG ----------
    //
    // ⚠️ ĐÂY LÀ LỖI ĐÃ XẢY RA THẬT TRÊN PRODUCTION, 17/09/2026 lúc 18:41.
    //
    // Rule lồng `match /tm_donhang/{poId}/nhanhang/{grnId}` ở trên **KHÔNG** áp cho truy vấn
    // `collectionGroup("nhanhang")`. Firestore coi collection group là một phép truy vấn khác
    // hẳn: nó cần một rule khớp ở MỌI cấp, tức phải có wildcard đệ quy `{duongDan=**}`.
    //
    // Hậu quả đo được: app gọi collectionGroup → bị từ chối → theo chốt `daNgheDu` trong
    // `kho-chung-tach.ts` (chỉ báo dữ liệu khi nghe đủ CẢ BẢY nguồn), thiếu một nguồn là app
    // **không bao giờ** hiện dữ liệu, và dải báo đứng mãi ở *"Chưa nối kho chung"*.
    //
    // 🔴 VÌ SAO PHÉP THỬ CỦA TÔI KHÔNG BẮT ĐƯỢC: tôi thử bằng **Admin SDK**, mà Admin SDK
    // BỎ QUA toàn bộ Security Rules. Nó chạy được không chứng minh gì về phía trình duyệt.
    // Muốn kiểm thật phải dùng client SDK có đăng nhập, hoặc Firebase Emulator.
    //
    // 📌 Giữ CẢ HAI khối: khối lồng ở trên cho truy cập trực tiếp một phiếu, khối này cho
    // truy vấn collection group. Quyền đặt giống hệt nhau để không có đường nào lỏng hơn.
    match /{duongDan=**}/nhanhang/{grnId} {
      allow read: if conHanChayThu() && duocXemHoSoMuaHang();
      allow create, update: if conHanChayThu() && thuKho();
      allow delete: if conHanChayThu() && quanLyThuMua();
    }


    // ---------- 🔒 GIÁ CỦA ĐƠN HÀNG — CHỨNG TỪ RIÊNG ----------
    // Đây là lý do tồn tại của cả cách tách document. ĐỪNG gộp lại vào `tm_donhang`.
    // Chứa: đơn giá từng dòng · chiết khấu · thuế suất · điều khoản thanh toán.
    match /tm_donhang_gia/{poId} {
      allow read: if conHanChayThu() && duocXemTien();
      allow create, update: if conHanChayThu() && nhapLieuThuMua();
      allow delete: if conHanChayThu() && quanLyThuMua();
    }

    // ---------- 🔒 BẢNG BÁO GIÁ — TOÀN BỘ chứa giá nhà cung cấp ----------
    match /tm_baogia/{rfqId} {
      allow read: if conHanChayThu() && duocXemTien();
      allow create, update: if conHanChayThu() && nhapLieuThuMua();
      allow delete: if conHanChayThu() && quanLyThuMua();
    }

    // ---------- THÔNG BÁO CHUYỂN BƯỚC ----------
    // ⚠️ Bản chạy thử cho mọi người đọc mọi thông báo. `firestore.rules` thiết kế chặt hơn
    // (mỗi người chỉ đọc thông báo gửi cho mình, và client KHÔNG được tự tạo). Siết theo
    // hướng đó được, nhưng phải đợi thông báo có trường `guiToiUid` và có Cloud Function ghi
    // — hiện app tự ghi từ trình duyệt, siết ngay là app không tạo được thông báo nào.
    match /tm_thongbao/{tbId} {
      allow read: if conHanChayThu() && daDangNhap();
      allow create, update: if conHanChayThu() && nhapLieuThuMua();
      allow delete: if conHanChayThu() && quanLyThuMua();
    }

    // ---------- CÀI ĐẶT DÙNG CHUNG ----------
    // Cấu hình quy trình · danh mục nhà cung cấp · danh mục thủ kho. Một tài liệu duy nhất
    // (`tm_caidat/chung`) cho cả công ty — không phải chứng từ nên không tách.
    // 🔴 Sửa cấu hình quy trình là đổi luật cho CẢ PHÒNG (ngưỡng giá trị, hạn từng bước), nên
    // quyền ghi hẹp hơn chứng từ thường.
    match /tm_caidat/{id} {
      allow read: if conHanChayThu() && daDangNhap();
      allow create, update: if conHanChayThu() && quanLyThuMua();
      allow delete: if false;
    }

    // Mọi đường dẫn khác: KHÓA. Kể cả khi sau này ai đó ghi nhầm dữ liệu thật vào một
    // collection mới, nó cũng không lộ ra ngoài.
    /* ★ KHOÁ MỀM — ai đang mở hồ sơ nào (đợt 1 lộ trình chống mất dữ liệu, 22/09/2026).
       Kho RIÊNG, cố ý không nằm chung `chay-thu` — nhét cờ "đang sửa" vào kho chung là vừa bị
       ghi đè xoá mất, vừa tự sinh thêm lượt ghi vào đúng chỗ đang nghẽn.

       🔴 AI CŨNG GHI ĐƯỢC, kể cả xoá — vì mỗi người tự dọn khoá của mình khi rời màn hình, và
       mã tài liệu đã gắn sẵn uid (`{loai}__{id}__{uid}`) nên không ai giả danh người khác được
       mà không bị lộ ngay trên giao diện. Dữ liệu ở đây KHÔNG phải chứng từ: mất hết cũng chỉ
       là mất cảnh báo, không mất nghiệp vụ. Siết chặt hơn mức này là đổi lấy rủi ro khoá chết
       hồ sơ khi người dùng đóng tab đột ngột. */
    match /dang-sua/{khoa} {
      allow read: if conHanChayThu() && duocVao();
      allow create, update, delete: if conHanChayThu() && duocVao();
    }

    /* ★ SỔ GIỮ CHỖ CẤP MÃ — nhịp 3b, 23/09/2026.

       🔴 CHẶN HẲN PHÍA NGƯỜI DÙNG, CỐ Ý. Sổ này chỉ do route `/api/cap-ma` ghi bằng Admin SDK
       (Admin SDK đi vòng qua rules). Mở cho trình duyệt là mở đúng cái vừa bịt: ai sửa được sổ
       thì cấp lại được mã đã cấp, và hai chứng từ lại mang một số.

       📌 Khối `match /{document=**}` ngay dưới vốn đã chặn mọi kho không khai báo, nên dòng này
       KHÔNG đổi hành vi — nó viết ra để người đọc rules sau này khỏi tưởng là bỏ sót. */
    match /cap-phat-ma/{khoa} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
